# =========================
# Terraform
# =========================

# Local .terraform directory (downloaded providers/modules)
.terraform/
.terraform.lock.hcl

# Terraform state files - NEVER commit these
# They contain sensitive data including passwords and resource IDs
terraform.tfstate
terraform.tfstate.backup

# Terraform variable files with sensitive values
terraform.tfvars
*.tfvars

# Terraform plan output
*.tfplan
*.plan

# Crash log files
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# =========================
# Credentials & Secrets
# =========================

# AWS credentials - NEVER commit
*.pem
*.ppk
.aws/

# Environment variable files
.env
.env.*

# =========================
# macOS
# =========================
.DS_Store
.AppleDouble
.LSOverride
._*

# =========================
# Editor / IDE
# =========================
.vscode/
.idea/
*.swp
*.swo
*~
